; Inventory template for the live-target arm of the evaluation campaign.
;
; Copy to deploy-inventory.ini and fill in the address and key emitted by
;   scripts/setup_multipass_target.sh
; The real file is gitignored: it carries a machine-specific address and a path
; to a private key.
;
; The group name MUST stay [appservers].  The fixture playbooks declare
; `hosts: appservers`, and ansible-playbook exits 0 with an empty PLAY RECAP
; when no host matches -- a deploy that silently did nothing would otherwise be
; recorded as a successful apply.

[appservers]
eval-target ansible_host=REPLACE_WITH_VM_IP

[appservers:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=REPLACE_WITH_KEY_PATH
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null
