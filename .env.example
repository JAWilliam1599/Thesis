# SysSecOps pipeline environment template.
# Copy to ".env" and fill in real values. ".env" is gitignored — never commit secrets.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# AWS credentials / region (used by boto3, Bedrock, CDK, SSM, EventBridge, etc.)
# ---------------------------------------------------------------------------
# Option A: static keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary/STS credentials
# Option B: named profile / SSO (leave keys blank if you use this)
# AWS_PROFILE=default
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
# CDK_DEFAULT_ACCOUNT=123456789012   # auto-detected from STS if omitted
# CDK_DEFAULT_REGION=ap-southeast-2

# ---------------------------------------------------------------------------
# Bedrock (generation bedrock provider)
# ---------------------------------------------------------------------------
BEDROCK_MODEL_ID=qwen.qwen3-coder-30b-a3b-v1:0

# ---------------------------------------------------------------------------
# OpenRouter (generation openrouter provider)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=qwen/qwen3-coder-30b-a3b-instruct
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_APP_NAME=thesis-codegen
# OPENROUTER_APP_URL=https://example.com

# ---------------------------------------------------------------------------
# Phase 4 observability toggles + notifications
# ---------------------------------------------------------------------------
SSM_ENABLED=true
EVENTBRIDGE_ENABLED=true
# SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:syssecops-gate
# RETRIGGER_MODE=notify_only

# ---------------------------------------------------------------------------
# Optional tooling
# ---------------------------------------------------------------------------
# JAVA_HOME=/usr/lib/jvm/default      # required only for OWASP Dependency-Check
